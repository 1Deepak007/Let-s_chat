                  "    <tr>\r",
                  "        <td>{{response.user._id}}</td>\r",
                  "        <td>{{response.user.username}}</td>\r",
                  "    </tr>\r",
                  "</table>\r",
                  "`;\r",
                  "\r",
                  "function constructVisualizerPayload() {\r",
                  "    return {response: pm.response.json()}\r",
                  "}\r",
